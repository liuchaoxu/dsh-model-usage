{
  "name": "dsh-model-usage",
  "version": "0.8.4",
  "description": "Provider-account usage for DeepSeek Harness: quota windows, credit balance and request counts for the model a conversation runs on, with per-provider adapters and manual target selection.",
  "license": "MIT",
  "author": "liuchaoxu <ischaoxu@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchaoxu/dsh-model-usage.git"
  },
  "homepage": "https://github.com/liuchaoxu/dsh-model-usage#readme",
  "bugs": {
    "url": "https://github.com/liuchaoxu/dsh-model-usage/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "llm",
    "usage",
    "token-usage",
    "quota",
    "billing",
    "balance",
    "commandcode",
    "openrouter",
    "opencode",
    "moonshot",
    "siliconflow",
    "new-api"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/check.mjs && node scripts/smoke.mjs",
    "test": "node scripts/check.mjs && node scripts/smoke.mjs",
    "prepublishOnly": "node scripts/check.mjs && node scripts/smoke.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
