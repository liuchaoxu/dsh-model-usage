{
  "name": "dsh-model-usage",
  "version": "0.8.1",
  "description": "DeepSeek Harness plugin: a 用量 button in the session header showing the provider-account usage behind the model the current conversation runs on (Command Code, DeepSeek, OpenCode Go, OpenRouter, Moonshot, SiliconFlow, New API), with a manual query-target override and background auto-refresh",
  "license": "MIT",
  "author": "liuchaoxu <ischaoxu@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchaoxu/dsh-model-usage.git"
  },
  "homepage": "https://github.com/liuchaoxu/dsh-model-usage#readme",
  "bugs": {
    "url": "https://github.com/liuchaoxu/dsh-model-usage/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "cordis",
    "usage",
    "balance",
    "commandcode",
    "openrouter",
    "moonshot",
    "siliconflow"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/check.mjs && node scripts/smoke.mjs",
    "prepublishOnly": "node scripts/check.mjs && node scripts/smoke.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
  "access": "public"
  }
}
